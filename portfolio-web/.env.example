DATABASE_URL="file:./dev.db"
# Required in production: >= 32 random chars (e.g. `openssl rand -base64 48`). Never commit the real value.
SESSION_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3020"
# Comma-separated admin SPA origins allowed by CORS (localhost:5174 is added automatically outside production)
ADMIN_ORIGIN="http://localhost:5174"
# Optional cookie overrides (defaults: local HTTP → Lax/insecure; production HTTPS → None/Secure)
# COOKIE_SECURE="false"
# SESSION_SAMESITE="lax"
# Seed only: admin password; random and printed if unset
# SEED_ADMIN_PASSWORD=""
